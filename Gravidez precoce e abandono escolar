<footer>
    <p>Trabalho Escolar</p>
    <p>Tema: Gravidez Precoce e Abandono Escolar</p>
    <p>Moçambique - 2026</p>
    <p>Todos juntos por uma educação melhor!</p>
</footer>

<script>

const perguntas = [
    "Ainda estás a frequentar a escola?",
    "A tua gravidez foi planeada?",
    "Os teus pais sabem da tua gravidez?",
    "Os teus pais te apoiaram quando souberam?",
    "O pai da criança te apoia?",
    "Já foste às consultas pré-natais no hospital?",
    "Sentes vergonha de ir à escola grávida?",
    "Algum colega já gozou contigo por estares grávida?",
    "Algum professor já te tratou mal por estares grávida?",
    "Pensas em continuar a estudar depois do parto?",
    "Tens alguém para cuidar do bebé quando voltares à escola?",
    "Já pensaste em desistir da escola?",
    "Recebeste educação sexual na escola antes de engravidar?"
];

const escolhas = [
    {
        pergunta: "Quem mais te ajuda neste momento?",
        opcoes: [
            "Mãe / Pai",
            "Namorado / Pai do bebé",
            "Professores",
            "Ninguém"
        ]
    },
    {
        pergunta: "Qual é a tua maior dificuldade agora?",
        opcoes: [
            "Vergonha / discriminação",
            "Falta de dinheiro",
            "Problemas de saúde / cansaço",
            "Falta de apoio do pai da criança"
        ]
    },
    {
        pergunta: "O que mais te fez falta antes de engravidar?",
        opcoes: [
            "Conversa com os pais",
            "Palestras na escola",
            "Acesso a preservativo",
            "Nada, eu sabia"
        ]
    },
    {
        pergunta: "O que queres fazer depois do bebé nascer?",
        opcoes: [
            "Voltar logo à escola",
            "Trabalhar",
            "Ficar em casa a cuidar do bebé",
            "Ainda não sei"
        ]
    },
    {
        pergunta: "Que conselho darias a outras meninas?",
        opcoes: [
            "Esperar para ter filho",
            "Usar preservativo",
            "Estudar primeiro",
            "Conversar com os pais"
        ]
    }
];

const areaPerguntas = document.getElementById("perguntas");

perguntas.forEach((pergunta, index) => {
    const numero = index + 1;

    areaPerguntas.innerHTML += `
        <label>${numero}. ${pergunta}</label>
        <label class="opcao">
            <input type="radio" name="p${numero}" value="Sim"> Sim
        </label>
        <label class="opcao">
            <input type="radio" name="p${numero}" value="Não"> Não
        </label>
    `;
});

const areaEscolhas = document.getElementById("escolhas");

escolhas.forEach((item, index) => {
    const numero = index + 15;

    let html = `<label>${numero}. ${item.pergunta}</label>`;

    item.opcoes.forEach(opcao => {
        html += `
            <label class="opcao">
                <input type="radio"
                name="p${numero}"
                value="${opcao}">
                ${opcao}
            </label>
        `;
    });

    areaEscolhas.innerHTML += html;
});

document.getElementById("formulario").addEventListener("submit",
function(event) {
    event.preventDefault();

    const dados = new FormData(this);
    const respostas = Object.fromEntries(dados.entries());

    console.log("Respostas do questionário:", respostas);

    document.getElementById("mensagem").textContent =
        "Respostas preenchidas com sucesso! Atenção: este formulário ainda não envia dados para uma base de dados.";

});

</script>

